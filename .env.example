# ---- Google Cloud / Gemini ----
# Local dev: set GOOGLE_API_KEY from Google AI Studio (https://aistudio.google.com/apikey)
# OR use Vertex AI / Gemini Enterprise: authenticate via ADC (gcloud auth application-default login)
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Set to True to route Gemini calls through the Gemini Enterprise Agent Platform
GOOGLE_GENAI_USE_ENTERPRISE=False

# Gemini model used by the agent and the synthesis step
GEMINI_MODEL=gemini-2.5-flash

# ---- Parallel ----
# API key from https://platform.parallel.ai
PARALLEL_API_KEY=
